#!/system/bin/sh

MODDIR=${0%/*}
NM_BIN="$MODDIR/nm"
NM_DATA="/data/adb/nomount"
LOG_FILE="$NM_DATA/selftest.log"
TAG="nomount-selftest-$$"
TMPROOT="/data/local/tmp/$TAG"
SYSTEM_PARENT=""
UID_SELF="$(id -u 2>/dev/null || echo 0)"
CAN_LIST=0
UID_BLOCKED_BY_TEST=0
PASS_COUNT=0
SKIP_COUNT=0

V_SYSTEM=""
V_LINK=""
V_SYNTH=""
V_EXISTING=""
V_WHITEOUT=""
V_CANON=""
V_DIR=""
V_STRESS=""
V_UIDSC=""
V_OPAQ=""
V_DENY=""
UID_TESTED=0

mkdir -p "$NM_DATA" >/dev/null 2>&1
: > "$LOG_FILE"

log() {
    printf '%s\n' "$*" | tee -a "$LOG_FILE"
}

stage() {
    log ""
    log "TEST: $*"
}

skip() {
    SKIP_COUNT=$((SKIP_COUNT + 1))
    log "SKIP: $*"
}

fail() {
    log "SELFTEST FAIL: $*"
    exit 1
}

pass() {
    PASS_COUNT=$((PASS_COUNT + 1))
    log "PASS: $*"
}

json_rules() {
    [ "$CAN_LIST" -eq 1 ] || {
        printf '[]\n'
        return 0
    }
    "$NM_BIN" list json 2>/dev/null
}

has_rule() {
    json_rules | tr -d '\n' | grep -F "\"virtual\": \"$1\"" >/dev/null 2>&1
}

has_whiteout_rule() {
    json_rules | tr -d '\n' | grep -F "\"virtual\": \"$1\"" |
        grep -F "\"whiteout\": true" >/dev/null 2>&1
}

require_rule() {
    if [ "$CAN_LIST" -eq 0 ]; then
        skip "list json unavailable; rule visibility check skipped for $1"
        return 0
    fi
    has_rule "$1"
}

require_no_rule() {
    if [ "$CAN_LIST" -eq 0 ]; then
        skip "list json unavailable; rule absence check skipped for $1"
        return 0
    fi
    if has_rule "$1"; then
        fail "unexpected rule remained for $1"
    fi
    pass "rule listing contains no entry for $1"
}

require_whiteout_rule() {
    if [ "$CAN_LIST" -eq 0 ]; then
        skip "list json unavailable; whiteout visibility check skipped for $1"
        return 0
    fi
    has_whiteout_rule "$1"
}

assert_text() {
    desc="$1"
    expected="$2"
    actual="$3"
    if [ "$expected" = "$actual" ]; then
        pass "$desc"
        return 0
    fi
    log "EXPECTED: $expected"
    log "ACTUAL:   $actual"
    fail "$desc"
}

stat_identity() {
    # /proc/<pid>/fd/N is a procfs symlink.  The metadata test must inspect
    # its referent, otherwise a healthy implementation is compared against
    # procfs's own inode and falsely reported as a NoMount leak.
    stat -L -c '%d:%i' "$1" 2>/dev/null
}

statfs_identity() {
    stat -f -c '%t:%i' "$1" 2>/dev/null
}

cleanup() {
    [ "$UID_BLOCKED_BY_TEST" -eq 1 ] && "$NM_BIN" unblock "$UID_SELF" >/dev/null 2>&1
    [ -n "$V_SYSTEM" ] && "$NM_BIN" del "$V_SYSTEM" >/dev/null 2>&1
    [ -n "$V_LINK" ] && "$NM_BIN" del "$V_LINK" >/dev/null 2>&1
    [ -n "$V_SYNTH" ] && "$NM_BIN" del "$V_SYNTH" >/dev/null 2>&1
    [ -n "$V_EXISTING" ] && "$NM_BIN" del "$V_EXISTING" >/dev/null 2>&1
    [ -n "$V_WHITEOUT" ] && "$NM_BIN" del "$V_WHITEOUT" >/dev/null 2>&1
    [ -n "$V_CANON" ] && "$NM_BIN" del "$V_CANON" >/dev/null 2>&1
    [ -n "$V_DIR" ] && "$NM_BIN" del "$V_DIR" >/dev/null 2>&1
    [ -n "$V_STRESS" ] && "$NM_BIN" del "$V_STRESS" >/dev/null 2>&1
    [ -n "$V_UIDSC" ] && "$NM_BIN" rule del --uid 5 "$V_UIDSC" >/dev/null 2>&1
    [ -n "$V_UIDSC" ] && "$NM_BIN" del "$V_UIDSC" >/dev/null 2>&1
    [ -n "$V_OPAQ" ] && "$NM_BIN" del "$V_OPAQ" >/dev/null 2>&1
    [ -n "$V_DENY" ] && "$NM_BIN" rule del --uid-range 19 21 --uid-excluded 20 "$V_DENY" >/dev/null 2>&1
    [ -n "$V_DENY" ] && "$NM_BIN" del "$V_DENY" >/dev/null 2>&1
    [ "$UID_TESTED" -eq 1 ] && "$NM_BIN" uid del 29999 29998 >/dev/null 2>&1
    rm -rf "$TMPROOT"
}

trap cleanup EXIT INT TERM

log "=== NoMount self-test start: $(date) ==="

if [ ! -x "$NM_BIN" ]; then
    fail "nm binary missing at $NM_BIN"
fi

stage "probe keyring version and rule-list capability"
VERSION="$($NM_BIN v 2>/dev/null | tr -d '\r\n')"
[ -n "$VERSION" ] || fail "nomount version query failed"
pass "keyring version query responded with '$VERSION'"
case "$VERSION" in
    ''|*[!0-9]*) CAN_LIST=0 ;;
    *) [ "$VERSION" -ge 13 ] && CAN_LIST=1 ;;
esac
[ "$CAN_LIST" -eq 1 ] || skip "list json checks require NoMount kernel interface v13+"

for candidate in /system/etc /vendor/etc /product/etc /system_ext/etc /odm/etc; do
    if [ -d "$candidate" ]; then
        SYSTEM_PARENT="$candidate"
        break
    fi
done

stage "prepare isolated files and backend types"
mkdir -p "$TMPROOT/base" "$TMPROOT/real" "$TMPROOT/real/directory" ||
    fail "failed to prepare temp tree"

printf 'stock-existing\n' > "$TMPROOT/base/existing.txt" || fail "failed to create existing file"
printf 'whiteout-source\n' > "$TMPROOT/base/whiteout.txt" || fail "failed to create whiteout file"
printf 'canonical-source\n' > "$TMPROOT/base/canonical-$TAG.txt" || fail "failed to create canonical file"
printf 'redirect-existing\n' > "$TMPROOT/real/replaced.txt" || fail "failed to create replacement file"
printf 'redirect-shared\n' > "$TMPROOT/real/shared.txt" || fail "failed to create shared file"
printf 'symlink-target\n' > "$TMPROOT/real/target.txt" || fail "failed to create symlink target"
printf 'directory-child\n' > "$TMPROOT/real/directory/child.txt" || fail "failed to create directory backend"
ln -sf "$TMPROOT/real/target.txt" "$TMPROOT/real/link.lnk" || fail "failed to create real symlink"

V_EXISTING="$TMPROOT/base/existing.txt"
V_WHITEOUT="$TMPROOT/base/whiteout.txt"
V_CANON="$TMPROOT/base/canonical-$TAG.txt"
V_SYNTH="$TMPROOT/virt-$TAG/dir-$TAG/file.txt"
V_DIR="$TMPROOT/base/directory-$TAG"
V_STRESS="$TMPROOT/base/stress-$TAG.txt"
V_SYSTEM=""
V_LINK=""
if [ -n "$SYSTEM_PARENT" ]; then
    V_SYSTEM="$SYSTEM_PARENT/$TAG-system.txt"
    V_LINK="$SYSTEM_PARENT/$TAG-link"
fi

stage "reject invalid requests without mutating policy"
INVALID_BACKEND="$TMPROOT/base/invalid-$TAG.txt"
if "$NM_BIN" add "$INVALID_BACKEND" "$TMPROOT/real/missing.txt" >/dev/null 2>&1; then
    fail "missing backend path was accepted"
fi
require_no_rule "$INVALID_BACKEND"
if "$NM_BIN" add / "$TMPROOT/real/shared.txt" >/dev/null 2>&1; then
    fail "root virtual path was accepted as a file rule"
fi
if "$NM_BIN" del "$INVALID_BACKEND" >/dev/null 2>&1; then
    fail "deleting a nonexistent rule unexpectedly succeeded"
fi
pass "invalid backend, root target, and missing-rule operations were rejected"

stage "preserve visible identity and virtual d_path during replacement"
VISIBLE_ID=""
BACKEND_ID=""
if command -v stat >/dev/null 2>&1; then
    VISIBLE_ID="$(stat -c '%d:%i' "$V_EXISTING" 2>/dev/null)" || fail "failed to stat original replacement target"
    BACKEND_ID="$(stat -c '%d:%i' "$TMPROOT/real/replaced.txt" 2>/dev/null)" || fail "failed to stat replacement backend"
    [ "$VISIBLE_ID" != "$BACKEND_ID" ] || fail "replacement metadata test requires distinct source inodes"
else
    skip "stat unavailable; replacement inode/device check skipped"
fi

"$NM_BIN" add "$V_EXISTING" "$TMPROOT/real/replaced.txt" >/dev/null 2>&1 ||
    fail "failed to add replacement rule"
assert_text "existing child replacement" "redirect-existing" "$(cat "$V_EXISTING" 2>/dev/null | tr -d '\r\n')"
if [ -n "$VISIBLE_ID" ]; then
    assert_text "replacement preserves visible inode/device" "$VISIBLE_ID" "$(stat -c '%d:%i' "$V_EXISTING" 2>/dev/null)"
fi
if command -v readlink >/dev/null 2>&1; then
    exec 9<"$V_EXISTING" || fail "failed to open replacement fd for d_path check"
    FD_TARGET="$(readlink "/proc/$$/fd/9" 2>/dev/null | tr -d '\r\n')"
    FD_ID="$(stat_identity "/proc/$$/fd/9")"
    exec 9<&-
    assert_text "replacement fd exposes virtual d_path" "$V_EXISTING" "$FD_TARGET"
    if [ -n "$VISIBLE_ID" ]; then
        assert_text "replacement fd preserves visible inode/device" "$VISIBLE_ID" "$FD_ID"
    fi
else
    skip "readlink unavailable; replacement d_path check skipped"
fi
require_rule "$V_EXISTING" || fail "replacement rule missing from list json"

"$NM_BIN" del "$V_EXISTING" >/dev/null 2>&1 || fail "failed to delete replacement rule"
assert_text "replacement cleanup restored stock file" "stock-existing" "$(cat "$V_EXISTING" 2>/dev/null | tr -d '\r\n')"

stage "canonicalize repeated slashes and dot components, then refresh replacement"
CANON_ALIAS="$TMPROOT/base//./sub/../canonical-$TAG.txt"
"$NM_BIN" add "$V_CANON" "$TMPROOT/real/replaced.txt" >/dev/null 2>&1 ||
    fail "failed to add canonical-path rule"
assert_text "canonical path initial content" "redirect-existing" "$(cat "$V_CANON" 2>/dev/null | tr -d '\r\n')"
"$NM_BIN" add "$CANON_ALIAS" "$TMPROOT/real/shared.txt" >/dev/null 2>&1 ||
    fail "failed to update canonical-path rule through alias"
assert_text "canonical alias updates the existing rule" "redirect-shared" "$(cat "$V_CANON" 2>/dev/null | tr -d '\r\n')"
require_rule "$V_CANON" || fail "canonical rule missing from list json"
if [ "$CAN_LIST" -eq 1 ] && has_rule "$CANON_ALIAS"; then
    fail "noncanonical alias was published as a duplicate rule"
fi
"$NM_BIN" del "$V_CANON" >/dev/null 2>&1 || fail "failed to delete canonical-path rule"
assert_text "canonical cleanup restored stock file" "canonical-source" "$(cat "$V_CANON" 2>/dev/null | tr -d '\r\n')"

stage "redirect a real directory and enumerate its children"
"$NM_BIN" add "$V_DIR" "$TMPROOT/real/directory" >/dev/null 2>&1 ||
    fail "failed to add directory redirect rule"
[ -d "$V_DIR" ] || fail "directory redirect did not expose a directory"
ls "$V_DIR" 2>/dev/null | grep -F child.txt >/dev/null 2>&1 ||
    fail "directory redirect did not enumerate backend child"
assert_text "redirected directory child read" "directory-child" \
    "$(cat "$V_DIR/child.txt" 2>/dev/null | tr -d '\r\n')"
if command -v stat >/dev/null 2>&1; then
    CHILD_STAT_INO="$(stat -c '%i' "$V_DIR/child.txt" 2>/dev/null)"
    CHILD_ENUM_INO="$(ls -i "$V_DIR" 2>/dev/null |
        awk '$NF == "child.txt" { print $1; exit }')"
    if [ -n "$CHILD_STAT_INO" ] && [ -n "$CHILD_ENUM_INO" ]; then
        assert_text "redirected child readdir/stat inode consistency" \
            "$CHILD_STAT_INO" "$CHILD_ENUM_INO"
    else
        skip "could not obtain redirected child inode from stat and ls -i"
    fi
else
    skip "stat unavailable; redirected child inode consistency skipped"
fi
require_rule "$V_DIR" || fail "directory rule missing from list json"
"$NM_BIN" del "$V_DIR" >/dev/null 2>&1 || fail "failed to delete directory redirect rule"
[ ! -e "$V_DIR" ] || fail "directory redirect remained after delete"
pass "directory redirect and child enumeration"

stage "inject into a system directory, test UID visibility, and preserve symlinks"
if [ -n "$V_SYSTEM" ]; then
    "$NM_BIN" add "$V_SYSTEM" "$TMPROOT/real/shared.txt" >/dev/null 2>&1 ||
        fail "failed to add system-dir injection rule"
    assert_text "system directory injected file content" "redirect-shared" "$(cat "$V_SYSTEM" 2>/dev/null | tr -d '\r\n')"
    ls "$SYSTEM_PARENT" 2>/dev/null | grep -F "${V_SYSTEM##*/}" >/dev/null 2>&1 ||
        fail "system directory readdir did not expose injected file"
    require_rule "$V_SYSTEM" || fail "system directory rule missing from list json"

    VISIBLE_FS_ID="$(statfs_identity "$SYSTEM_PARENT")"
    INJECTED_FS_ID="$(statfs_identity "$V_SYSTEM")"
    if [ -n "$VISIBLE_FS_ID" ] && [ -n "$INJECTED_FS_ID" ]; then
        assert_text "injected file preserves visible filesystem metadata" \
            "$VISIBLE_FS_ID" "$INJECTED_FS_ID"
    else
        skip "stat -f filesystem metadata format unavailable"
    fi

    if command -v stat >/dev/null 2>&1; then
        SYSTEM_ENUM_INO="$(ls -i "$SYSTEM_PARENT" 2>/dev/null |
            awk -v n="${V_SYSTEM##*/}" '$NF == n { print $1; exit }')"
        SYSTEM_STAT_INO="$(stat -c '%i' "$V_SYSTEM" 2>/dev/null)"
        if [ -n "$SYSTEM_ENUM_INO" ] && [ -n "$SYSTEM_STAT_INO" ]; then
            assert_text "injected readdir/stat inode consistency" \
                "$SYSTEM_STAT_INO" "$SYSTEM_ENUM_INO"
        else
            skip "could not obtain injected inode from stat and ls -i"
        fi
        # Toybox prints '?' for every metadata column when its dirfd-relative
        # fstatat() lookup misses an injected entry.  Checking ls -li catches
        # that real *at() regression instead of only comparing getdents d_ino.
        SYSTEM_LONG_ENTRY="$(ls -li "$SYSTEM_PARENT" 2>/dev/null |
            awk -v n="${V_SYSTEM##*/}" '$NF == n { print; exit }')"
        if [ -n "$SYSTEM_LONG_ENTRY" ]; then
            case "$SYSTEM_LONG_ENTRY" in
                *'?'*) fail "injected directory-fd metadata lookup" ;;
                *) pass "injected directory-fd metadata lookup" ;;
            esac
        else
            skip "could not obtain injected ls -li entry"
        fi
    fi

    if [ "$UID_SELF" = "0" ]; then
        skip "uid block test skipped for uid 0 to avoid blocking root/WebUI"
    else
        if "$NM_BIN" block "$UID_SELF" >/dev/null 2>&1; then
            UID_BLOCKED_BY_TEST=1
            [ ! -e "$V_SYSTEM" ] || fail "uid block did not hide injected file lookup"
            if ls "$SYSTEM_PARENT" 2>/dev/null | grep -F "${V_SYSTEM##*/}" >/dev/null 2>&1; then
                fail "uid block did not hide injected file from readdir"
            fi
            "$NM_BIN" unblock "$UID_SELF" >/dev/null 2>&1 || fail "failed to unblock current uid"
            UID_BLOCKED_BY_TEST=0
            assert_text "uid unblock restored injected file" "redirect-shared" "$(cat "$V_SYSTEM" 2>/dev/null | tr -d '\r\n')"
        else
            skip "uid block test skipped because the current UID was already blocked"
        fi
    fi

    "$NM_BIN" add "$V_LINK" "$TMPROOT/real/link.lnk" >/dev/null 2>&1 ||
        fail "failed to add symlink redirect rule"
    assert_text "symlink redirect preserves target content" "symlink-target" "$(cat "$V_LINK" 2>/dev/null | tr -d '\r\n')"
    if command -v readlink >/dev/null 2>&1; then
        assert_text "symlink redirect preserves link target" "$TMPROOT/real/target.txt" "$(readlink "$V_LINK" 2>/dev/null | tr -d '\r\n')"
    else
        skip "readlink unavailable; symlink target text check skipped"
    fi
    require_rule "$V_LINK" || fail "symlink rule missing from list json"
    "$NM_BIN" del "$V_LINK" >/dev/null 2>&1 || fail "failed to delete symlink rule"
    "$NM_BIN" del "$V_SYSTEM" >/dev/null 2>&1 || fail "failed to delete system-dir injection rule"
else
    skip "no readable system/vendor/etc parent found; system-dir tests skipped"
fi

stage "create and prune synthetic ancestor directories"
"$NM_BIN" add "$V_SYNTH" "$TMPROOT/real/shared.txt" >/dev/null 2>&1 ||
    fail "failed to add synthetic ancestor rule"
assert_text "synthetic nested lookup content" "redirect-shared" "$(cat "$V_SYNTH" 2>/dev/null | tr -d '\r\n')"
ls "$(dirname "$V_SYNTH")" 2>/dev/null | grep -F "${V_SYNTH##*/}" >/dev/null 2>&1 ||
    fail "synthetic leaf directory readdir missing injected file"
ls "$(dirname "$(dirname "$V_SYNTH")")" 2>/dev/null | grep -F "$(basename "$(dirname "$V_SYNTH")")" >/dev/null 2>&1 ||
    fail "synthetic ancestor readdir missing child directory"
require_rule "$V_SYNTH" || fail "synthetic rule missing from list json"
"$NM_BIN" del "$V_SYNTH" >/dev/null 2>&1 || fail "failed to delete synthetic rule"
[ ! -e "$(dirname "$(dirname "$V_SYNTH")")" ] || fail "synthetic ancestor was not pruned after delete"
pass "synthetic ancestor cleanup pruned intermediate directories"

stage "hide and restore an existing file with a whiteout rule"
"$NM_BIN" w "$V_WHITEOUT" >/dev/null 2>&1 || fail "failed to add whiteout rule"
[ ! -e "$V_WHITEOUT" ] || fail "whiteout did not hide existing file lookup"
if ls "$TMPROOT/base" 2>/dev/null | grep -F "whiteout.txt" >/dev/null 2>&1; then
    fail "whiteout did not hide existing file from readdir"
fi
require_whiteout_rule "$V_WHITEOUT" || fail "whiteout rule missing from list json"
"$NM_BIN" del "$V_WHITEOUT" >/dev/null 2>&1 || fail "failed to delete whiteout rule"
assert_text "whiteout cleanup restored file" "whiteout-source" "$(cat "$V_WHITEOUT" 2>/dev/null | tr -d '\r\n')"

if [ "$CAN_LIST" -eq 1 ]; then
    stage "ABI-16: uid exclusion list add/list/del roundtrip"
    if "$NM_BIN" uid add 29999 29998 >/dev/null 2>&1; then
        UID_TESTED=1
        UID_LIST_OUT="$("$NM_BIN" uid list 2>/dev/null)"
        UID_HAS_9999="$(printf '%s\n' "$UID_LIST_OUT" | grep -Fcx "29999")"
        UID_HAS_9998="$(printf '%s\n' "$UID_LIST_OUT" | grep -Fcx "29998")"
        if [ "$UID_HAS_9999" -ge 1 ] && [ "$UID_HAS_9998" -ge 1 ]; then
            pass "uid list exposes both added entries"
        else
            log "EXPECTED: 29999 and 29998 both present"
            log "ACTUAL:   $(printf '%s' "$UID_LIST_OUT" | tr '\n' ' ')"
            fail "uid additions did not render"
        fi
        "$NM_BIN" uid del 29999 >/dev/null 2>&1 || fail "failed to delete first uid entry"
        UID_LEFT_9999="$(printf '%s\n' "$("$NM_BIN" uid list 2>/dev/null)" | grep -Fcx "29999")"
        if [ "$UID_LEFT_9999" -eq 0 ]; then
            pass "deleted uid entry vanished from the list"
        else
            fail "deleted uid entry 29999 remained"
        fi
        "$NM_BIN" uid del 29998 >/dev/null 2>&1 || fail "failed to delete second uid entry"
        UID_TESTED=0
        pass "uid exclusion list reclaimed cleanly"
    else
        skip "uid list commands rejected; CLI packs an older ABI"
    fi

    stage "ABI-16: uid-scoped rule stays invisible to out-of-scope lookups"
    V_UIDSC="$TMPROOT/base/scoped-$TAG.txt"
    if "$NM_BIN" rule add --uid 5 "$V_UIDSC" "$TMPROOT/real/shared.txt" >/dev/null 2>&1; then
        [ ! -e "$V_UIDSC" ] || fail "uid-5-scoped rule leaked into a root lookup"
        JSON_SCOPED="$(json_rules | tr -d '\n')"
        case "$JSON_SCOPED" in *"\"virtual\": \"$V_UIDSC\""*"\"uid_start\": 5"*"\"uid_end\": 5"*)
                pass "uid-scoped rule renders the exact uid window"
                ;;
            *)
                log "EXPECTED: uid_start 5 / uid_end 5 for $V_UIDSC"
                log "ACTUAL:   $(printf '%s' "$JSON_SCOPED" | cut -c1-200)"
                fail "uid-scoped rule render was wrong"
                ;;
        esac
        "$NM_BIN" rule del --uid 5 "$V_UIDSC" >/dev/null 2>&1 ||
            fail "exact-tuple scoped delete was rejected"
        [ ! -e "$V_UIDSC" ] || fail "scoped rule remained after exact-tuple delete"
        V_UIDSC=""
        pass "uid-scoped rule add/render/delete roundtrip"
    else
        skip "scoped rule commands rejected; CLI packed an older ABI"
    fi

    stage "ABI-16: deny window renders in the uid range and deletes exactly"
    V_DENY="$TMPROOT/base/deny-$TAG.txt"
    if "$NM_BIN" rule add --uid-range 19 21 --uid-excluded 20 "$V_DENY" "$TMPROOT/real/shared.txt" >/dev/null 2>&1; then
        [ ! -e "$V_DENY" ] || fail "rule scoped to uids 19-21 leaked to root lookup"
        JSON_DENY="$(json_rules | tr -d '\n')"
        case "$JSON_DENY" in *"\"virtual\": \"$V_DENY\""*"\"uid_start\": 19"*"\"uid_end\": 21"*"\"deny_start\": 20"*"\"deny_end\": 20"*)
                pass "deny window renders inside its uid range"
                ;;
            *)
                log "EXPECTED: uid range 19-21 with deny 20 for $V_DENY"
                log "ACTUAL:   $(printf '%s' "$JSON_DENY" | cut -c1-220)"
                fail "deny window render was wrong"
                ;;
        esac
        "$NM_BIN" rule del --uid-range 19 21 --uid-excluded 20 "$V_DENY" >/dev/null 2>&1 ||
            fail "exact-tuple deny delete was rejected"
        [ ! -e "$V_DENY" ] || fail "deny rule remained after exact-tuple delete"
        V_DENY=""
        pass "deny window rule add/render/delete roundtrip"
    else
        skip "deny-window rule commands rejected; CLI packed an older ABI"
    fi

    stage "ABI-16: opaque directory lists backend but hides child lookups"
    V_OPAQ="$TMPROOT/base/opaque-$TAG"
    mkdir -p "$V_OPAQ" || fail "failed to prepare opaque virtual dir"
    "$NM_BIN" rule add --opaque "$V_OPAQ" "$TMPROOT/real/directory" >/dev/null 2>&1 ||
        fail "failed to add opaque dir rule"
    ls "$V_OPAQ" 2>/dev/null | grep -F child.txt >/dev/null 2>&1 ||
        fail "opaque dir readdir did not list the backend child"
    if [ -e "$V_OPAQ/child.txt" ]; then
        fail "opaque dir leaked child lookup (children must stay negative)"
    else
        pass "opaque dir child lookup stayed negative"
    fi
    require_rule "$V_OPAQ" || fail "opaque dir rule missing from list json"
    "$NM_BIN" del "$V_OPAQ" >/dev/null 2>&1 || fail "failed to delete opaque dir rule"
    V_OPAQ=""
    pass "opaque directory redirect behaves"
else
    skip "ABI-16 stages skipped; rule listing requires NoMount kernel interface v13+"
fi

stage "repeat rule add, read, and delete to exercise lifecycle reclamation"
printf 'stress-source\n' > "$V_STRESS" || fail "failed to create stress target"
i=1
while [ "$i" -le 8 ]; do
    "$NM_BIN" add "$V_STRESS" "$TMPROOT/real/shared.txt" >/dev/null 2>&1 ||
        fail "stress add failed at iteration $i"
    assert_text "stress iteration $i read" "redirect-shared" "$(cat "$V_STRESS" 2>/dev/null | tr -d '\r\n')"
    "$NM_BIN" del "$V_STRESS" >/dev/null 2>&1 || fail "stress delete failed at iteration $i"
    assert_text "stress iteration $i cleanup" "stress-source" "$(cat "$V_STRESS" 2>/dev/null | tr -d '\r\n')"
    i=$((i + 1))
done
require_no_rule "$V_STRESS"
pass "eight repeated add/read/delete cycles completed"

log ""
log "SKIP: clear command is intentionally not self-tested because it is global and destructive"
log "SUMMARY: passes=$PASS_COUNT skips=$SKIP_COUNT"
log "SELFTEST PASS: NoMount hookless features look healthy"
exit 0
